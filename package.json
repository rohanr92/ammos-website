{
  "name": "ammos-website",
  "version": "1.0.0",
  "private": true,
  "description": "Ammos Makenzy Beach — website, events booking and admin panel",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:create": "tsx scripts/create-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "menu:sync": "tsx scripts/sync-menu.ts",
    "gallery:instagram": "tsx scripts/import-instagram.ts",
    "setup": "npm run db:create && npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "lenis": "1.3.26",
    "next": "16.4.1",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
