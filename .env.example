# ─────────────────────────────────────────────────────────────
#  Ammos website — environment settings
#  Copy this file to ".env" and fill in your own values.
#  NEVER share or commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Public address of the website (no slash at the end)
#   local:      http://localhost:3000
#   production: https://ammos.eu
SITE_URL=http://localhost:3000

# PostgreSQL connection
#   format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ammos

# Secret used to sign admin login tokens (JWT).
# Must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# First admin account (created by "npm run db:seed" if no admin exists yet).
# Use a strong password (12+ characters). Change it after first login.
ADMIN_EMAIL=info@ammos.eu
ADMIN_PASSWORD=ChangeThisPassword!2026
ADMIN_NAME=Ammos Admin

# Where uploaded images/videos are stored on disk
UPLOAD_DIR=./uploads

# ── Email (SMTP) ─────────────────────────────────────────────
# Contact & booking forms send email through these settings.
# Hostinger email: host smtp.hostinger.com, port 465, secure true.
# Leave SMTP_HOST empty while testing — emails are then printed in the terminal.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@ammos.eu
SMTP_PASS=
MAIL_FROM="Ammos Makenzy Beach <info@ammos.eu>"
# Where form notifications are delivered (you can add more, separated by commas)
MAIL_TO=info@ammos.eu
